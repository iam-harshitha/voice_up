# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# development | test | production
APP_ENV=development
APP_NAME=Approval Line
API_V1_PREFIX=/api/v1

# Must use the Psycopg 3 dialect: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# URL-encode special characters in the password (e.g. "@" -> "%40").
DATABASE_URL=postgresql+psycopg://approval_line:CHANGE_ME@localhost:5432/approval_line

# Dedicated, disposable database for the test suite. Its name must contain "test"
# and it must differ from DATABASE_URL: the tests drop and recreate its schema.
TEST_DATABASE_URL=postgresql+psycopg://approval_line:CHANGE_ME@localhost:5432/approval_line_test

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins. Empty disables CORS. "*" is rejected,
# and with APP_ENV=production only https:// origins are accepted. The dashboard is
# served same-origin, so production usually leaves this empty.
CORS_ORIGINS=

# --- Docker Compose only (used by docker-compose.yml to initialise PostgreSQL) ---
POSTGRES_USER=approval_line
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=approval_line
POSTGRES_PORT=5432

# --- Voice approvals (Chunk 2) -----------------------------------------------------------
# disabled (default) | mock (tests/local development only; refused in production) | bolna
VOICE_PROVIDER=disabled

# Required when VOICE_PROVIDER=bolna. Never commit real values.
BOLNA_API_BASE_URL=https://api.bolna.ai
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional: a number purchased in your Bolna account (otherwise the account default).
BOLNA_FROM_PHONE_NUMBER=
# Names of the post-call extractions configured on the Bolna agent (see docs/voice-bolna.md).
BOLNA_EXTRACTION_CATEGORY=Approval
BOLNA_DECISION_EXTRACTION=Decision
BOLNA_IDENTITY_EXTRACTION=Identity Confirmed
BOLNA_CONDITION_EXTRACTION=Condition

# Shared secret Bolna sends in the custom webhook header X-Approval-Line-Webhook-Token.
# At least 32 characters; generate with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
VOICE_WEBHOOK_TOKEN=
VOICE_WEBHOOK_MAX_BYTES=262144

# A decision (and identity confirmation) needs at least this provider confidence (0..1).
VOICE_MIN_DECISION_CONFIDENCE=0.8

# Worker and provider behaviour.
VOICE_HTTP_TIMEOUT_SECONDS=10
VOICE_WORKER_POLL_SECONDS=2
VOICE_JOB_LEASE_SECONDS=120
VOICE_JOB_MAX_ATTEMPTS=5
VOICE_RETRY_BASE_SECONDS=5
VOICE_RETRY_MAX_SECONDS=300
VOICE_RECONCILE_AFTER_SECONDS=600
VOICE_CALL_TIMEOUT_SECONDS=3600
VOICE_MAX_CALL_GENERATIONS=3

# Development only (VOICE_PROVIDER=mock): directory shared by API, worker and CLI for
# simulated executions, e.g. ./.mock_voice  (git-ignored)
VOICE_MOCK_STATE_DIR=

# --- Dashboard sign-in (Chunk 4) ---------------------------------------------------------
# Users are created with: python -m app.cli create-dashboard-user ... (never in this file).
# Absolute session lifetime in seconds (300 .. 604800).
DASHBOARD_SESSION_TTL_SECONDS=28800
# Secure flag on the session cookie. Leave empty: on in production, off otherwise.
# "false" is refused when APP_ENV=production.
DASHBOARD_COOKIE_SECURE=
# Consecutive failed sign-ins before a temporary lock, and the lock duration (seconds).
DASHBOARD_MAX_FAILED_LOGINS=5
DASHBOARD_LOCKOUT_SECONDS=900

# --- MCP server and demo agent (Chunk 4) ---------------------------------------------------
# These are read by `python -m approval_line_agents.mcp_server` and
# `python -m approval_line_agents.demo` from THEIR OWN environment (or the MCP client's
# config), not by the API. Use a dedicated least-privilege agent key:
#   requests:create,requests:read   (+ audit:read / policies:read for those MCP tools)
# APPROVAL_LINE_API_URL=http://127.0.0.1:8000
# APPROVAL_LINE_API_KEY=<agent key; never commit>
# APPROVAL_LINE_TIMEOUT_SECONDS=10
