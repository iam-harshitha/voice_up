# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# development | test | production
APP_ENV=development
APP_NAME=Approval Line
API_V1_PREFIX=/api/v1

# Must use the Psycopg 3 dialect: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# URL-encode special characters in the password (e.g. "@" -> "%40").
DATABASE_URL=postgresql+psycopg://approval_line:CHANGE_ME@localhost:5432/approval_line

# Dedicated, disposable database for the test suite. Its name must contain "test"
# and it must differ from DATABASE_URL: the tests drop and recreate its schema.
TEST_DATABASE_URL=postgresql+psycopg://approval_line:CHANGE_ME@localhost:5432/approval_line_test

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins. Empty disables CORS. "*" is rejected.
CORS_ORIGINS=

# --- Docker Compose only (used by docker-compose.yml to initialise PostgreSQL) ---
POSTGRES_USER=approval_line
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=approval_line
POSTGRES_PORT=5432
