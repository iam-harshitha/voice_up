{
  "permissions": {
    "allow": [
      "Bash(./deploy.sh production)",
      "PowerShell(./deploy.ps1 production)",
      "PowerShell(.\\deploy.ps1 production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/../env/Scripts/python.exe",
            "args": ["-m", "approval_line_agents.guard"],
            "timeout": 420,
            "onFailure": "block",
            "statusMessage": "Approval Line: waiting for a human to approve by phone"
          }
        ]
      }
    ]
  }
}
